{
  "name": "claudios-club",
  "version": "0.2.0",
  "private": true,
  "description": "Quadro branco para orquestrar agentes do Claude Code entre projetos",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build && tsx scripts/bundle.ts",
    "start": "tsx scripts/bundle.ts && node dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mod:install": "tsx scripts/install-mod.ts",
    "mod:uninstall": "tsx scripts/install-mod.ts --uninstall",
    "setup": "npm install --no-audit --no-fund && tsx scripts/daily.ts setup",
    "daily": "tsx scripts/daily.ts run",
    "daily:start": "tsx scripts/daily.ts start",
    "daily:stop": "tsx scripts/daily.ts stop",
    "daily:status": "tsx scripts/daily.ts status",
    "doctor": "tsx scripts/doctor.ts",
    "launcher": "tsx scripts/launcher.ts",
    "launcher:remove": "tsx scripts/launcher.ts --remove",
    "autostart": "tsx scripts/autostart.ts",
    "autostart:remove": "tsx scripts/autostart.ts --remove"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/caveat": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@xyflow/react": "^12.12.0",
    "codemirror": "^6.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "roughjs": "^4.6.6",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
